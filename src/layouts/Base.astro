---
import '../styles/base.css';
import cormorant from '../assets/fonts/cormorant-latin-wght-normal.woff2?url';
import lato from '../assets/fonts/lato-latin-400-normal.woff2?url';
import LysDefs from '../components/LysDefs.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE, lien } from '../lib/site';

interface Props {
  titre: string;
  description: string;
  type?: 'website' | 'article';
  jsonld?: object[];
  actif?: string;
  publie?: string;
  modifie?: string;
  noindex?: boolean;
}
const { titre, description, type = 'website', jsonld = [], actif, publie, modifie, noindex } = Astro.props;
const chemin = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '');
const canonique = new URL(chemin || '/', Astro.site).href;
const image = new URL(lien('/og.jpg'), Astro.site).href;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{titre}</title>
  <meta name="description" content={description}>
  {noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonique}>}
  <meta name="theme-color" content="#FBFBFB">
  <link rel="preload" href={cormorant} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={lato} as="font" type="font/woff2" crossorigin>
  <link rel="icon" href={lien('/favicon.ico')} sizes="32x32">
  <link rel="icon" href={lien('/favicon.svg')} type="image/svg+xml">
  <link rel="apple-touch-icon" href={lien('/apple-touch-icon.png')}>
  <link rel="alternate" type="application/rss+xml" title="Le Journal de PLT Family Office" href={lien('/journal/rss.xml')}>
  <meta property="og:site_name" content={SITE.nom}>
  <meta property="og:locale" content="fr_FR">
  <meta property="og:type" content={type}>
  <meta property="og:title" content={titre}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonique}>
  <meta property="og:image" content={image}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {publie && <meta property="article:published_time" content={publie}>}
  {modifie && <meta property="article:modified_time" content={modifie}>}
  <meta name="twitter:card" content="summary_large_image">
  {jsonld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  <script is:inline>try{if(!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('js','ouverture')}catch(e){}</script>
</head>
<body>
  <LysDefs />
  <Nav actif={actif} />
  <main>
    <slot />
  </main>
  <Footer />
  <script is:inline>
(function(){
  var root=document.documentElement,reduce=matchMedia('(prefers-reduced-motion: reduce)').matches,$=function(s){return [].slice.call(document.querySelectorAll(s))};
  var nav=document.getElementById('top'),bar=nav.querySelector('.progress');
  if(!reduce)setTimeout(function(){root.classList.remove('ouverture')},120);

  // Onglets « Notre conseil » : clic ou survol
  var tabs=$('.tab');
  function pick(t){tabs.forEach(function(x){var on=x===t;x.classList.toggle('on',on);x.setAttribute('aria-selected',on)})}
  tabs.forEach(function(t){t.addEventListener('click',function(){pick(t)});t.addEventListener('mouseenter',function(){if(matchMedia('(hover:hover)').matches)pick(t)})});

  // Fondateurs : parcours déplié
  $('.fiche .plus').forEach(function(b){b.addEventListener('click',function(){var o=b.closest('.fiche').classList.toggle('ouvert');b.setAttribute('aria-expanded',o);b.firstChild.nodeValue=o?'Refermer':'Lire le parcours'})});

  // Vidéos : l'iframe YouTube n'est chargée qu'au clic
  $('.video').forEach(function(v){v.querySelector('button').addEventListener('click',function(){var f=document.createElement('iframe');f.src='https://www.youtube-nocookie.com/embed/'+v.dataset.id+'?autoplay=1';f.title='Vidéo';f.allow='autoplay; encrypted-media; picture-in-picture';f.allowFullscreen=true;v.replaceChildren(f)})});

  // Titres : mots qui montent derrière un masque
  $('.split').forEach(function(h){
    var i=0;
    (function walk(node){[].slice.call(node.childNodes).forEach(function(c){
      if(c.nodeType===3){var frag=document.createDocumentFragment();c.textContent.split(/(\s+)/).forEach(function(t){
        if(!t)return;if(/^\s+$/.test(t)){frag.appendChild(document.createTextNode(t));return}
        var o=document.createElement('span');o.className='m';var n=document.createElement('span');n.textContent=t;n.style.setProperty('--i',i++);o.appendChild(n);frag.appendChild(o)});node.replaceChild(frag,c)}
      else if(c.nodeType===1&&c.tagName!=='BR')walk(c)})})(h);
  });
  var vh=innerHeight||800,watch=$('.split,.tete-centre');
  if('IntersectionObserver' in window&&!reduce){
    var first=watch.filter(function(el){return el.getBoundingClientRect().top<vh*.95});setTimeout(function(){first.forEach(function(el){el.classList.add('vu')})},180);
    var io2=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('vu');io2.unobserve(e.target)}})},{rootMargin:'0px 0px -8% 0px'});
    watch.forEach(function(el){if(first.indexOf(el)<0)io2.observe(el)});
    var els=$('.rv');els.forEach(function(el){if(el.getBoundingClientRect().top>vh*.92)el.classList.add('attente')});
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.remove('attente');io.unobserve(e.target)}})},{rootMargin:'0px 0px -6% 0px'});
    els.forEach(function(el){io.observe(el)});
  }else watch.forEach(function(el){el.classList.add('vu')});

  // Défilement : barre de progression, en-tête compact, parallaxe légère
  var hero=document.querySelector('.hero'),fin=document.querySelector('.final'),ghost=fin&&fin.querySelector('.ghost');
  function onScroll(){
    var y=scrollY,max=document.documentElement.scrollHeight-innerHeight;
    nav.classList.toggle('scrolled',y>8);
    bar.style.setProperty('--p',max>0?(y/max).toFixed(4):0);
    if(reduce)return;
    if(hero&&y<1200)hero.style.setProperty('--py',(y*.18).toFixed(1)+'px');
    if(fin){var r=fin.getBoundingClientRect();if(r.top<innerHeight&&r.bottom>0)ghost.style.setProperty('--gy',((r.top-innerHeight/2)*-.12).toFixed(1)+'px')}
  }
  addEventListener('scroll',onScroll,{passive:true});onScroll();
})();
  </script>
</body>
</html>
