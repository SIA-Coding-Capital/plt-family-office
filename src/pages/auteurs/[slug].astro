---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Carte from '../../components/Carte.astro';
import '../../styles/journal.css';
import { SITE, lien } from '../../lib/site';
import { articlesPublies } from '../../lib/journal';

export async function getStaticPaths() {
  return (await getCollection('auteurs')).map((p) => ({ params: { slug: p.data.slug }, props: { p } }));
}
const { p } = Astro.props;
const d = p.data;
const { Content } = await render(p);
const siens = (await articlesPublies()).filter((a) => a.data.auteur === d.nom);
const url = new URL(lien(`/auteurs/${d.slug}`), Astro.site).href;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    url,
    mainEntity: {
      '@type': 'Person',
      name: d.nom,
      jobTitle: d.fonction,
      worksFor: { '@type': 'Organization', name: SITE.nom, url: new URL(lien('/'), Astro.site).href },
      knowsAbout: d.expertise,
      sameAs: d.same_as.filter((s) => s.startsWith('http')),
      url,
    },
  },
];
---
<Base titre={`${d.title} | PLT Family Office`} description={d.meta_description} jsonld={jsonld} actif="journal">
  <div class="wrap" style="padding-top:64px">
    <article class="prose">
      <Content />
    </article>
  </div>
  {siens.length > 0 && (
    <section class="wrap liste">
      <h2 class="grappe-bloc" style="font-size:30px;margin-bottom:28px">Ses articles</h2>
      <div class="articles">{siens.map((a) => <Carte a={a} />)}</div>
    </section>
  )}
</Base>
