---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/journal.css';
import { SITE, lien, portrait } from '../../lib/site';

export async function getStaticPaths() {
  return (await getCollection('auteurs')).map((p) => ({ params: { slug: p.data.slug }, props: { p } }));
}
const { p } = Astro.props;
const d = p.data;
const { Content } = await render(p);
const url = new URL(lien(`/auteurs/${d.slug}`), Astro.site).href;
const personne = `${url}#personne`;
const photo = portrait(d.slug);
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    url,
    dateModified: d.date_mise_a_jour.toISOString().slice(0, 10),
    mainEntity: {
      '@type': 'Person',
      '@id': personne,
      description: d.meta_description,
      ...(photo && { image: new URL(photo, Astro.site).href }),
      name: d.nom,
      jobTitle: d.fonction,
      worksFor: { '@type': 'Organization', name: SITE.nom, url: new URL(lien('/'), Astro.site).href },
      knowsAbout: d.expertise,
      sameAs: d.same_as.filter((s) => s.startsWith('http')),
      url,
    },
  },
  ...d.livres.map((l) => ({
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: l.titre,
    inLanguage: 'fr-FR',
    author: { '@id': personne },
    ...(l.url && { url: l.url }),
    ...(l.isbn && { isbn: l.isbn }),
  })),
];
---
<Base titre={`${d.title} | PLT Family Office`} description={d.meta_description} jsonld={jsonld} actif="journal">
  <div class="wrap auteur">
    <article class="prose">
      {photo && (
        <figure class="auteur-photo">
          <img src={photo} alt={`Portrait de ${d.nom}`} width="222" height="250" fetchpriority="high">
        </figure>
      )}
      <Content />
    </article>
  </div>
</Base>
