---
import { render } from 'astro:content';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AppelFinal from '../../components/AppelFinal.astro';
import '../../styles/journal.css';
import { SITE, lien, dateLongue } from '../../lib/site';
import { articlesPublies, grappe, minutes, publieLe, misAJourLe, type Article } from '../../lib/journal';

export async function getStaticPaths() {
  return (await articlesPublies()).map((a) => ({ params: { slug: a.data.slug }, props: { a } }));
}

const { a } = Astro.props as { a: Article };
const { Content } = await render(a);
const d = a.data;
const auteurs = await getCollection('auteurs');
const auteur = auteurs.find((x) => x.data.nom === d.auteur);
const urlAuteur = auteur ? lien(`/auteurs/${auteur.data.slug}`) : undefined;
const pub = publieLe(a);
const maj = misAJourLe(a);
const abs = (p: string) => new URL(lien(p), Astro.site).href;
const url = abs(`/journal/${d.slug}`);

const jsonld: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.meta_description,
    abstract: d.resume_geo,
    inLanguage: 'fr-FR',
    mainEntityOfPage: url,
    url,
    image: abs('/og.jpg'),
    datePublished: pub,
    dateModified: maj,
    wordCount: (a.body ?? '').split(/\s+/).length,
    articleSection: grappe(a),
    keywords: [d.mot_cle_principal, ...d.mots_cles_secondaires].join(', '),
    author: {
      '@type': 'Person',
      name: d.auteur,
      ...(auteur && { url: abs(`/auteurs/${auteur.data.slug}`), jobTitle: auteur.data.fonction, sameAs: auteur.data.same_as.filter((s) => s.startsWith('http')) }),
    },
    publisher: { '@type': 'Organization', '@id': new URL('/#organisation', Astro.site).href, name: SITE.nom, logo: { '@type': 'ImageObject', url: abs('/apple-touch-icon.png') } },
    citation: d.sources,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Journal', item: abs('/journal') },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
if (d.faq.length)
  jsonld.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
  });
for (const v of d.videos)
  jsonld.push({
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: v.titre,
    description: v.titre,
    thumbnailUrl: `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`,
    uploadDate: v.date_publication.toISOString().slice(0, 10),
    duration: v.duree,
    contentUrl: v.url,
    embedUrl: `https://www.youtube-nocookie.com/embed/${v.id}`,
    hasPart: v.passages.map((p, i) => ({
      '@type': 'Clip',
      name: p.label,
      startOffset: p.t,
      ...(v.passages[i + 1] && { endOffset: v.passages[i + 1].t }),
      url: `${v.url}&t=${p.t}s`,
    })),
  });
---
<Base titre={`${d.title} | PLT Family Office`} description={d.meta_description} type="article" jsonld={jsonld} actif="journal" publie={pub} modifie={maj}>
  <header class="page-tete">
    <div class="wrap">
      <nav class="fil" aria-label="Fil d'Ariane">
        <ol><li><a href={lien('/')}>Accueil</a></li><li><a href={lien('/journal')}>Journal</a></li><li>{grappe(a)}</li></ol>
      </nav>
      <p class="sur">{grappe(a)} · {minutes(a)} min de lecture</p>
      <h1 class="split">{d.title}</h1>
      <p class="signature">
        Par {urlAuteur ? <a href={urlAuteur} rel="author">{d.auteur}</a> : d.auteur}, cofondateur de PLT Family Office.<br>
        Publié le <time datetime={pub}>{dateLongue(pub)}</time>{maj !== pub && <>, mis à jour le <time datetime={maj}>{dateLongue(maj)}</time></>}.
      </p>
    </div>
  </header>
  <div class="wrap">
    <article class="prose">
      <Content />
    </article>
  </div>
  <AppelFinal />
</Base>
