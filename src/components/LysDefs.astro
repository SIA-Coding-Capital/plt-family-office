---
import brut from '../data/lys-path.txt?raw';
const d = brut.trim();
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs><linearGradient id="lys-g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F7EBDF"/><stop offset="1" stop-color="#EFE8E2"/></linearGradient></defs>
  <symbol id="lys" viewBox="0 0 30 37"><g transform="translate(0 37) rotate(-90)"><path d={d}/></g></symbol>
  <symbol id="lys-h" viewBox="0 0 37 30"><path d={d}/></symbol>
</svg>
